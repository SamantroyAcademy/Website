# Copy to .env.local and fill in. .env.local is gitignored.

# Supabase: Project -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Legacy: only used when R2 is not configured.
NEXT_PUBLIC_SUPABASE_MEDIA_BUCKET=media
# SERVER ONLY, never expose: used to create admins, save leads and score mock tests.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (https://resend.com/api-keys). Without it, leads are still saved to the CRM.
RESEND_API_KEY=
CONTACT_ADMIN_EMAIL=info@samantroyacademy.com
CONTACT_FROM_EMAIL=Samantroy Academy <noreply@samantroyacademy.com>

# Google reviews import via Places API (optional)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_PLACE_QUERY=Samantroy Academy, Odisha

# Cloudflare R2: every image and file is stored here and loaded by browsers
# directly from R2 (never through Vercel). R2 -> Manage API tokens -> Object Read & Write.
# SERVER ONLY: the three R2_* keys below sign uploads; never expose them.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=samantroy-media
# Public URL of the bucket: the r2.dev URL, or a custom domain such as https://media.samantroyacademy.com
NEXT_PUBLIC_R2_PUBLIC_URL=

# Cloudflare Turnstile: invisible bot check on the enquiry, lead and mock-test
# forms. Without the secret the server skips verification (forms still work).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Odia translation (navbar switch). Free OpenRouter models only.
OPENROUTER_API_KEY=
# Any long random string; Vercel cron sends it to /api/cron/i18n.
CRON_SECRET=
