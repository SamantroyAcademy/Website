# Copy to .env.local and fill in. .env.local is gitignored.

# Supabase: Project -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_SUPABASE_MEDIA_BUCKET=media
# SERVER ONLY, never expose: used to create admins, save leads and score mock tests.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (https://resend.com/api-keys). Without it, leads are still saved to the CRM.
RESEND_API_KEY=
CONTACT_ADMIN_EMAIL=info@samantroyacademy.com
CONTACT_FROM_EMAIL=Samantroy Academy <noreply@samantroyacademy.com>

# Google reviews import via Places API (optional)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_PLACE_QUERY=Samantroy Academy, Odisha
